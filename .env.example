# ---- Node (bee2bee) --------------------------------------------------------
# HTTP API key. If unset, a random key is generated in ~/.bee2bee/api_key.
BEE2BEE_API_KEY=
# Public address other peers use to reach this node.
BEE2BEE_ANNOUNCE_HOST=
# Bootstrap peers (comma separated ws:// or wss:// URLs).
BEE2BEE_BOOTSTRAP=
# Gateway that accepts signed registrations, e.g. https://coithub.org
BEE2BEE_REGISTRY_URL=
BEE2BEE_REGION=Auto
# TLS for the P2P port (wss://). Or terminate TLS in a reverse proxy.
BEE2BEE_TLS_CERT=
BEE2BEE_TLS_KEY=
BEE2BEE_REQUIRE_TLS=false
HF_TOKEN=
OLLAMA_HOST=http://localhost:11434

# ---- Gateway ---------------------------------------------------------------
BEE2BEE_SEEDS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose it to the browser or to nodes.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=
METRICS_TOKEN=
STATIC_API_KEYS=
