# Gateway base URL. Leave empty when the gateway serves /api on the same origin
# (Docker image, or Vercel rewrite). In development Vite proxies /api to :3001.
VITE_API_BASE_URL=
# Supabase public settings (anon key only; never put the service-role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable "Sign in with GitHub" (configure the provider in Supabase first).
VITE_AUTH_GITHUB=false
# Optional Microsoft Clarity project id. Loaded only after the visitor consents.
VITE_CLARITY_ID=
