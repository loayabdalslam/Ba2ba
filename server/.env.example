# Neon connection string (use the pooled "-pooler" host).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Seconds without a heartbeat after which a node counts as offline.
ONLINE_WINDOW_SECONDS=90
# Only for local testing: allow probing nodes on private addresses.
ALLOW_PRIVATE_NODES=false
# Extra CORS origins (the Tauri app origins are always allowed).
CORS_ORIGINS=
