  "private": true,
  "description": "Central Bee2Bee directory: which nodes are online, their models, providers and performance. Runs on Vercel with Neon Postgres.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "migrate": "tsx scripts/migrate.ts",
